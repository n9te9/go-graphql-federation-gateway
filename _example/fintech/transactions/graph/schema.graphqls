extend schema
  @link(url: "https://specs.apollo.dev/federation/v2.0",
        import: ["@key", "@external", "@requires"])

type Transaction @key(fields: "id") @key(fields: "auditId") {
  id: ID!
  amount: Int!
  auditId: ID!
  createdAt: String!
  modifiedAt: String!
  modifiedBy: String!
}

extend type Auditable @key(fields: "auditId") {
  auditId: ID!
}

extend type Account @key(fields: "iban") {
  iban: ID! @external
  balance: Int! @external
  transactions: [Transaction!]!
  riskScore: Float! @requires(fields: "balance")
}
