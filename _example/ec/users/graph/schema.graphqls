extend schema
  @link(url: "https://specs.apollo.dev/federation/v2.0",
        import: ["@key", "@shareable", "@interfaceObject"])

interface Node {
  id: ID!
}

type Profile {
  displayName: String!
  avatarUrl: String!
}

type User implements Node @key(fields: "id") @key(fields: "username") @key(fields: "email") {
  id: ID!
  username: String! @shareable
  email: String!
  profile: Profile!
}

type Query {
  me: User
  userById(id: ID!): User
  userByUsername(username: String!): User
  userByEmail(email: String!): User
}
