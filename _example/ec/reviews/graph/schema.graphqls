extend schema
  @link(url: "https://specs.apollo.dev/federation/v2.0",
        import: ["@key", "@external", "@interfaceObject", "@provides"])

interface Node {
  id: ID!
}

type Review implements Node {
  id: ID!
  body: String!
  authorName: String!
  product: Product @provides(fields: "name price")
}

type Product @key(fields: "id") {
  id: ID! @external
  reviews: [Review]
}
